; NPT equilibration for protein systems (Amber ff14SB + OpenFF Sage)
title                   = NPT equilibration
define                  = -DPOSRES

; Run parameters
integrator              = md
nsteps                  = 50000
dt                      = 0.002

; Output control
nstxout                 = 500
nstvout                 = 500
nstenergy               = 500
nstlog                  = 500

; Bond parameters
continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4

; Neighbor searching
cutoff-scheme           = Verlet
ns_type                 = grid
nstlist                 = 10
pbc                     = xyz

; Electrostatics and VdW (Sage-style nonbonded settings)
coulombtype             = PME
pme_order               = 4
fourierspacing          = 0.16
rcoulomb                = 0.9
rvdw                    = 0.9
vdwtype                 = cutoff
vdw-modifier            = Potential-switch
rvdw-switch             = 0.8
DispCorr                = EnerPres

; Temperature coupling
tcoupl                  = V-rescale
tc-grps                 = Protein Non-Protein
tau_t                   = 0.1     0.1
ref_t                   = 300     300

; Pressure coupling
pcoupl                  = Berendsen
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5

; Velocity generation
gen_vel                 = no
