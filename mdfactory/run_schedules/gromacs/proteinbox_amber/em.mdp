; Energy minimization parameters for protein systems (Amber ff14SB + OpenFF Sage)
integrator  = steep
emtol       = 1000.0
emstep      = 0.01
nsteps      = 50000

; Neighbor searching
nstlist         = 1
cutoff-scheme   = Verlet
ns_type         = grid
pbc             = xyz

; Electrostatics and VdW (Sage-style nonbonded settings)
coulombtype     = PME
rcoulomb        = 0.9
rvdw            = 0.9
vdwtype         = cutoff
vdw-modifier    = Potential-switch
rvdw-switch     = 0.8
DispCorr        = EnerPres
